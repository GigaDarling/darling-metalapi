index 0000000..44737fa
--- /dev/null
+++ b/tests/probes/read_write_float_modify.metal
@@ -0,0 +1,15 @@
+// EXPECT: valid
+// REFLECT: "texture_access": "ReadWrite"
+// DISASM: OpImageRead
+// DISASM: OpImageWrite
+// DISASM: StorageImageReadWithoutFormat
+// DISASM: StorageImageWriteWithoutFormat
+// DISASM-NOT: NonReadable
+// DISASM-NOT: NonWritable
+#include <metal_stdlib>
+using namespace metal;
+kernel void rw_float(texture2d<float,access::read_write> image [[texture(3)]],uint2 p [[thread_position_in_grid]]) {
+    if (p.x<image.get_width() && p.y<image.get_height()) {
+        float4 value=image.read(p);image.write(float4(value.z,value.y,value.x,value.w),p);
+    }
+}
