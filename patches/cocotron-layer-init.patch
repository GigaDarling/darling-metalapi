diff --git a/AppKit/NSView.m b/AppKit/NSView.m
index 5caa1d22..84c7c28a 100644
--- a/AppKit/NSView.m
+++ b/AppKit/NSView.m
@@ -85,6 +85,12 @@ const NSViewFullScreenModeOptionKey NSFullScreenModeApplicationPresentationOptio
 
 static BOOL NSViewLayersEnabled = YES;
 static BOOL NSShowAllViews = NO;
+static inline void configureLayerGeometry(NSView *self);
+
+static NSRect layerFrameInWindow(NSView *view) {
+    NSView *parent = [view superview];
+    return parent ? [parent convertRect: [view frame] toView: nil] : [view frame];
+}
 
 + (void) initialize {
     NSUserDefaults *defaults = [NSUserDefaults standardUserDefaults];
@@ -445,6 +451,12 @@ typedef struct __VFlags {
     _alphaValue = 1.0;
     _allowedTouchTypes = NSTouchTypeMaskDirect;
 
+    // A layer requested before super's initializer captured the object's
+    // zero-initialized alpha and bounds. Keep both entry points consistent
+    // with requesting the backing layer after initialization.
+    [_layer setOpacity: _alphaValue];
+    configureLayerGeometry(self);
+
     return self;
 }
 
@@ -1118,12 +1130,7 @@ static BOOL applyFrame(NSView *self, NSRect frame) {
         [self resizeSubviewsWithOldSize: oldSize];
     }
 
-    NSRect layerFrame = self->_frame;
-
-    if (self->_superview != nil)
-        layerFrame = [self->_superview convertRect: layerFrame toView: nil];
-
-    [self->_layerContext setFrame: layerFrame];
+    [self->_layerContext setFrame: layerFrameInWindow(self)];
 
     invalidateTransform(self);
     return YES;
@@ -1238,7 +1245,7 @@ static void postFrameChange(NSView *self) {
         if (_layerContext && _window == nil) {
             [self _removeLayerFromSuperlayer];
         } else if (_layerContext) {
-            [_layerContext setSubwindow: [_window _createSubWindowWithFrame: [self frame]]];
+            [_layerContext setSubwindow: [_window _createSubWindowWithFrame: layerFrameInWindow(self)]];
             [self _updateLayerVisibility];
         } else if (_layer != nil && _window != nil) {
             [self _addLayerToSuperlayer];
@@ -1993,10 +2000,13 @@ static char inputContextKey;
 
 - (void) _createLayerContextIfNeeded {
     if (_layerContext == nil && [_superview layer] == nil && _window != nil) {
-        _layerContext = [[CALayerContext alloc] initWithFrame: [self frame]];
+        // Native child windows use window coordinates, including all ancestor
+        // offsets, just as the subsequent frame-update path does.
+        NSRect windowFrame = layerFrameInWindow(self);
+        _layerContext = [[CALayerContext alloc] initWithFrame: windowFrame];
         [_layerContext setLayer: _layer];
         if (_window) {
-            [_layerContext setSubwindow: [_window _createSubWindowWithFrame: [self frame]]];
+            [_layerContext setSubwindow: [_window _createSubWindowWithFrame: windowFrame]];
             [self _updateLayerVisibility];
         }
     }
