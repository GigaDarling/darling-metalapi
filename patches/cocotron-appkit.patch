     return YES;
 }
 
+// A focus change between windows of this client must not transiently resign
+// the application. Native child windows can own the X input focus, so resolve
+// their ancestry to the AppKit platform window rather than matching only XIDs.
+static X11Window *ownedInputFocusWindow(X11Display *display, Display *dpy) {
+    Window focus = None, root = DefaultRootWindow(dpy);
+    int revert;
+    XGetInputFocus(dpy, &focus, &revert);
+    if (focus == PointerRoot) {
+        Window reportedRoot, child;
+        int rootX, rootY, localX, localY;
+        unsigned int state;
+        if (!XQueryPointer(dpy, root, &reportedRoot, &child, &rootX, &rootY,
+                           &localX, &localY, &state))
+            return nil;
+        focus = child;
+    }
+    while (focus != None && focus != root) {
+        X11Window *owned = (X11Window *) [display windowForID: focus];
+        if (owned != nil)
+            return [owned isMapped] ? owned : nil;
+        Window parent, reportedRoot, *children = NULL;
+        unsigned int count;
+        Status found = XQueryTree(dpy, focus, &reportedRoot, &parent, &children, &count);
+        if (children != NULL)
+            XFree(children);
+        if (!found || parent == focus)
+            break;
+        focus = parent;
+    }
+    return nil;
+}
