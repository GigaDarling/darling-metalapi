+        // here cancels an open NSMenu before its mouse-up can send the action.
+        // https://www.x.org/releases/current/doc/libX11/libX11/libX11.html
+        if (ev->xfocus.mode == NotifyGrab || ev->xfocus.mode == NotifyUngrab)
+            break;
         NSLog(@"FocusIn");
         // The server can still report FocusIn (detail NotifyPointer) for a
         // window we have unmapped; an ordered-out window must not become key.
@@ -1853,16 +1891,18 @@ static BOOL relativeEventPoint(Display *dpy, X11Window *window, const X11Relativ
             [[delegate attachedSheet] makeKeyAndOrderFront: delegate];
             break;
         }
-        if (lastFocusedWindow) {
-            [lastFocusedWindow platformWindowDeactivated: window
-                                 checkForAppDeactivation: NO];
-            lastFocusedWindow = nil;
-        }
+        id previousFocusedWindow = [[lastFocusedWindow retain] autorelease];
+        lastFocusedWindow = nil;
         if (window != nil)
             window->_receivingFocus = YES;
         [delegate platformWindowActivated: window displayIfNeeded: YES];
         if (window != nil)
             window->_receivingFocus = NO;
+        // Mark the new owner active before retiring the previous one. This
+        // keeps NSApplication active across its own popup/key-window transfer.
+        if (previousFocusedWindow != nil && previousFocusedWindow != delegate)
+            [previousFocusedWindow platformWindowDeactivated: window
