@@ -1875,7 +1915,13 @@ static BOOL relativeEventPoint(Display *dpy, X11Window *window, const X11Relativ
         break;
 
     case FocusOut:
+        if (ev->xfocus.mode == NotifyGrab || ev->xfocus.mode == NotifyUngrab)
+            break;
         NSLog(@"FocusOut");
+        // FocusIn will complete an internal transfer. Deactivating now would
+        // queue NSApplicationDeactivated and cancel menu tracking prematurely.
+        if (ownedInputFocusWindow(self, _display) != nil)
+            break;
         [delegate platformWindowDeactivated: window
